<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vpnguard.xray</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/vpnguard-xray</string>
        <string>run</string>
        <string>-c</string>
        <string>/usr/local/etc/vpnguard/xray.json</string>
    </array>

    <key>UserName</key>
    <string>_vpnguard_proxy</string>

    <key>GroupName</key>
    <string>vpnguard-proxy</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/vpnguard-xray.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/vpnguard-xray.log</string>
</dict>
</plist>
